{
  "name": "ytdlp-cookie-keeper",
  "version": "0.1.0",
  "description": "Keep your yt-dlp YouTube cookies fresh on a headless server: export from a persistent browser profile, validate against real videos, atomically swap — never clobber a working cookie file with a broken one.",
  "license": "MIT",
  "author": "Bryan Kuang",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ytdlp-cookie-keeper": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "yt-dlp",
    "ytdlp",
    "youtube",
    "cookies",
    "cookies-from-browser",
    "headless",
    "bot-detection",
    "sign-in-to-confirm"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^20.12.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "typescript": "^5.4.5"
  }
}
